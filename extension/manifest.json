{
  "manifest_version": 3,
  "name": "B站按需字幕",
  "version": "0.5.2",
  "description": "B站按需字幕插件：无字幕视频一键生成字幕文件，播放时自动同步显示，字幕库持久化管理",
  "permissions": ["offscreen", "storage", "unlimitedStorage", "downloads", "nativeMessaging"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.mcdn.bilivideo.cn/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站按需字幕"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["shared-subs.js", "sub-ui.js"],
      "run_at": "document_idle"
    }
  ]
}
